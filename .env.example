# "mock" uses the in-browser demo API (default). "http" calls a real backend (Project 2).
VITE_API_MODE=mock
# Base URL of the Project 2 backend, used only when VITE_API_MODE=http.
VITE_API_BASE_URL=http://localhost:8080/api/v1
# Simulated network latency for the mock API, in milliseconds.
VITE_MOCK_LATENCY_MS=450
