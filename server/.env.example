# Copy to server/.env (never commit the real file). All values here are examples.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/farha
# true when the database needs TLS (most hosted Postgres). Defaults to true in production.
DATABASE_SSL=false
# Long random value, e.g. `openssl rand -base64 48`. Required in production.
APP_SECRET=
# Sites allowed to call the API from a browser (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173
# Cookies: secure=true needs HTTPS. Use samesite=none only if the website and API are on different sites.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# true when running behind a load balancer / proxy that sets X-Forwarded-*.
TRUST_PROXY=false
# Serve the built website + dashboard from this folder (run `npm run build` first), e.g. ../dist
SERVE_STATIC_DIR=
# Demo deployments only: return one-time codes in the API response instead of sending an SMS.
DEMO_MODE=false
# Password for sample staff accounts when running `npm run db:seed -- --sample`.
SEED_STAFF_PASSWORD=
