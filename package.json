{
  "name": "farha-events-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build:demo": "vite build --config vite.demo.config.ts",
    "build:admin-demo": "DEMO_APP=admin vite build --config vite.demo.config.ts",
    "server:dev": "tsx watch --tsconfig server/tsconfig.json --env-file-if-exists=server/.env server/src/index.ts",
    "server:start": "node --env-file-if-exists=server/.env dist-server/index.js",
    "server:build": "esbuild server/src/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --tsconfig=server/tsconfig.json --outfile=dist-server/index.js && esbuild server/scripts/db.ts --bundle --platform=node --target=node22 --format=esm --packages=external --tsconfig=server/tsconfig.json --outfile=dist-server/db.js",
    "server:typecheck": "tsc -p server/tsconfig.json",
    "server:test": "vitest run --config server/vitest.config.ts",
    "db:migrate": "tsx --tsconfig server/tsconfig.json --env-file-if-exists=server/.env server/scripts/db.ts migrate",
    "db:seed": "tsx --tsconfig server/tsconfig.json --env-file-if-exists=server/.env server/scripts/db.ts seed",
    "db:create-admin": "tsx --tsconfig server/tsconfig.json --env-file-if-exists=server/.env server/scripts/db.ts create-admin"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@hookform/resolvers": "^3.10.0",
    "fastify": "^5.12.7",
    "i18next": "^25.10.10",
    "lucide-react": "^1.57.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^15.7.4",
    "react-router-dom": "^7.18.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.8",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  }
}
